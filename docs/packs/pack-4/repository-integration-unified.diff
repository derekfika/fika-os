diff --git "a/schemas\\pack-4\\validate-fixtures.js" "b/schemas\\pack-4\\validate-fixtures.js"
new file mode 100644
index 0000000..88ee843
--- /dev/null
+++ "b/schemas\\pack-4\\validate-fixtures.js"
@@ -0,0 +1,3 @@
+﻿const fs=require('fs'); const path=require('path');
+function check(s,o,p='') { let e=[]; if(s.type==='object'){ if(o===null||Array.isArray(o)||typeof o!=='object') return [`${p||'/'}: expected object`]; for(const r of (s.required||[])) if(!(r in o)) e.push(`${p}/${r}: required property missing`); if(s.additionalProperties===false) for(const k of Object.keys(o)) if(!s.properties||!(k in s.properties)) e.push(`${p}/${k}: additional property not allowed`); for(const [k,v] of Object.entries(o)) if(s.properties&&s.properties[k]) e=e.concat(check(s.properties[k],v,`${p}/${k}`)); } else if(s.type==='array'){ if(!Array.isArray(o)) e.push(`${p}: expected array`); else { if(s.minItems&&o.length<s.minItems) e.push(`${p}: too few items`); o.forEach((x,i)=>{ if(s.items) e=e.concat(check(s.items,x,`${p}/${i}`)); }); } } else if(s.type==='string'){ if(typeof o!=='string') e.push(`${p}: expected string`); if(s.const!==undefined&&o!==s.const) e.push(`${p}: expected const ${s.const}`); if(s.enum&&!s.enum.includes(o)) e.push(`${p}: not in enum`); if(s.minLength&&o.length<s.minLength) e.push(`${p}: too short`); } else if(s.type==='integer'){ if(!Number.isInteger(o)) e.push(`${p}: expected integer`); if(s.minimum!==undefined&&o<s.minimum) e.push(`${p}: below minimum`); } else if(s.type==='number'){ if(typeof o!=='number') e.push(`${p}: expected number`); if(s.exclusiveMinimum!==undefined&&!(o>s.exclusiveMinimum)) e.push(`${p}: not above exclusive minimum`); } else if(s.type==='boolean'){ if(typeof o!=='boolean') e.push(`${p}: expected boolean`); if(s.const!==undefined&&o!==s.const) e.push(`${p}: expected const ${s.const}`); } return e; }
+const base=path.resolve(__dirname); let results=[], failures=0; for(const sf of fs.readdirSync(base).filter(f=>f.endsWith('.schema.json')).sort()){ const s=JSON.parse(fs.readFileSync(path.join(base,sf),'utf8')); const stem=sf.replace('.schema.json',''); for(const [kind,expected] of [['valid','pass'],['invalid','fail']]){ const fp=path.join(base,'fixtures',kind,`${kind}-${stem}.json`); const o=JSON.parse(fs.readFileSync(fp,'utf8')); const errors=check(s,o); const actual=errors.length?'fail':'pass'; const passed=actual===expected; if(!passed) failures++; results.push({schema:sf,fixture:path.basename(fp),expected,actual,passed,errors}); }} console.log(JSON.stringify({validator:'local structural subset validator',failures,results},null,2)); process.exit(failures?1:0);
