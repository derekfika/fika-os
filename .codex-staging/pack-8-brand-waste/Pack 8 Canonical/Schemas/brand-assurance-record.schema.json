{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fika:schema:draft:brand-assurance-record:1",
  "title": "Brand Assurance Record v1 (Draft)",
  "description": "Draft record of what was verified when a proposed Brand Variation was reviewed against the applicable Brand Standard.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "brandAssuranceRecordId", "brandVariationId", "brandStandardReference", "verifiedItems", "reviewedAt", "reviewedByAssignmentId", "provenance", "audit"],
  "properties": {
    "schemaVersion": { "const": "1.0.0-draft.1" },
    "brandAssuranceRecordId": { "$ref": "#/$defs/stableId" },
    "brandVariationId": { "$ref": "#/$defs/stableId" },
    "brandStandardReference": { "$ref": "#/$defs/stableId" },
    "verifiedItems": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "evidenceReferences": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } },
    "reviewedAt": { "$ref": "#/$defs/isoDateTime" },
    "reviewedByAssignmentId": { "$ref": "#/$defs/stableId" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "audit": { "$ref": "#/$defs/audit" }
  },
  "$defs": {
    "stableId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$" },
    "isoDateTime": { "type": "string", "format": "date-time" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceBdrIds", "sourceSnapshot"],
      "properties": {
        "sourceBdrIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^(BRAND|ROLE)-\\d{3}$" } },
        "sourceSnapshot": { "type": "string", "minLength": 1 }
      }
    },
    "auditEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventType", "occurredAt", "actorAssignmentId"],
      "properties": {
        "eventType": { "type": "string", "minLength": 1 },
        "occurredAt": { "$ref": "#/$defs/isoDateTime" },
        "actorAssignmentId": { "$ref": "#/$defs/stableId" },
        "reason": { "type": "string" }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "createdAt", "createdByAssignmentId", "updatedAt", "updatedByAssignmentId", "events"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "createdAt": { "$ref": "#/$defs/isoDateTime" },
        "createdByAssignmentId": { "$ref": "#/$defs/stableId" },
        "updatedAt": { "$ref": "#/$defs/isoDateTime" },
        "updatedByAssignmentId": { "$ref": "#/$defs/stableId" },
        "events": { "type": "array", "items": { "$ref": "#/$defs/auditEvent" } }
      }
    }
  },
  "x-fika-source-bdrs": ["BRAND-001", "ROLE-002"],
  "x-fika-status": "Draft review candidate; not approved or adopted"
}
