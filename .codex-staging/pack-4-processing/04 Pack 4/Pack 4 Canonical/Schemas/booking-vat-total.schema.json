{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fika-os.local/schemas/pack-4/booking-vat-total.schema.json",
  "title": "Booking VAT Rounding and Totals",
  "description": "Draft business schema for ex-VAT pricing, end-of-quote VAT calculation and round-up preference from BOOK-005.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "sourceDecisionIds",
    "pricingBasis",
    "vatCalculationPoint",
    "roundingPreference",
    "subtotalExVat",
    "vatAmount",
    "totalIncVat",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "pack-4-draft"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "sourceDecisionIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    },
    "pricingBasis": {
      "type": "string",
      "const": "ex_vat"
    },
    "vatCalculationPoint": {
      "type": "string",
      "const": "quote_total"
    },
    "roundingPreference": {
      "type": "string",
      "const": "round_up"
    },
    "subtotalExVat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": "integer",
          "description": "Minor currency units."
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        }
      }
    },
    "vatAmount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": "integer",
          "description": "Minor currency units."
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        }
      }
    },
    "totalIncVat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": "integer",
          "description": "Minor currency units."
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        }
      }
    },
    "roundingAdjustment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": "integer",
          "description": "Minor currency units."
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        }
      }
    }
  }
}
