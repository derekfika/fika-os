{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fika:schema:draft:mobilisation-task:1",
  "title": "Mobilisation Task v1 (Draft)",
  "description": "Draft Mobilisation task classified as mandatory, capability-conditional or Client/Operational-Location-specific.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mobilisationTaskId", "mobilisationId", "title", "classification", "owningRoleId", "sourceRequirement", "dependencyTaskIds", "provenance", "audit"],
  "properties": {
    "schemaVersion": { "const": "1.0.0-draft.1" },
    "mobilisationTaskId": { "$ref": "#/$defs/stableId" },
    "mobilisationId": { "$ref": "#/$defs/stableId" },
    "title": { "type": "string", "minLength": 1 },
    "classification": { "type": "string", "enum": ["mandatory", "capability_conditional", "client_or_operational_location_specific"] },
    "owningRoleId": { "$ref": "#/$defs/stableId" },
    "assignedToAssignmentId": { "$ref": "#/$defs/stableId" },
    "sourceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mandatoryTaskCatalogueReference": { "$ref": "#/$defs/stableId" },
        "capabilityEnablementReference": { "$ref": "#/$defs/stableId" },
        "specificRequirementReference": { "$ref": "#/$defs/stableId" },
        "specificRequirementScope": { "type": "string", "enum": ["client", "operational_location"] }
      }
    },
    "dependencyTaskIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } },
    "provenance": { "$ref": "#/$defs/provenance" },
    "audit": { "$ref": "#/$defs/audit" }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "classification": { "const": "mandatory" },
        "sourceRequirement": { "type": "object", "required": ["mandatoryTaskCatalogueReference"] }
      }
    },
    {
      "type": "object",
      "properties": {
        "classification": { "const": "capability_conditional" },
        "sourceRequirement": { "type": "object", "required": ["capabilityEnablementReference"] }
      }
    },
    {
      "type": "object",
      "properties": {
        "classification": { "const": "client_or_operational_location_specific" },
        "sourceRequirement": { "type": "object", "required": ["specificRequirementReference", "specificRequirementScope"] }
      }
    }
  ],
  "$defs": {
    "stableId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$" },
    "isoDateTime": { "type": "string", "format": "date-time" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceBdrIds", "sourceSnapshot"],
      "properties": {
        "sourceBdrIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^(MOB|CAP|ROLE)-\\d{3}$" } },
        "sourceSnapshot": { "type": "string", "minLength": 1 }
      }
    },
    "auditEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventType", "occurredAt", "actorAssignmentId"],
      "properties": {
        "eventType": { "type": "string", "minLength": 1 },
        "occurredAt": { "$ref": "#/$defs/isoDateTime" },
        "actorAssignmentId": { "$ref": "#/$defs/stableId" },
        "reason": { "type": "string" }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "createdAt", "createdByAssignmentId", "updatedAt", "updatedByAssignmentId", "events"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "createdAt": { "$ref": "#/$defs/isoDateTime" },
        "createdByAssignmentId": { "$ref": "#/$defs/stableId" },
        "updatedAt": { "$ref": "#/$defs/isoDateTime" },
        "updatedByAssignmentId": { "$ref": "#/$defs/stableId" },
        "events": { "type": "array", "items": { "$ref": "#/$defs/auditEvent" } }
      }
    }
  },
  "x-fika-source-bdrs": ["MOB-004", "CAP-001", "ROLE-002"],
  "x-fika-status": "Draft review candidate; not approved or adopted"
}
