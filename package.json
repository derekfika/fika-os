{
  "name": "fika-os-local",
  "private": true,
  "scripts": {
    "dev": "node tools/dev/supervisor.mjs",

    "dev:hub": "npm --prefix apps/integration-hub run dev",
    "dev:hospitality": "npm --prefix apps/hospitality-booking run dev",
    "dev:cpu": "npm --prefix apps/cpu-production run dev",
    "dev:menu": "npm --prefix apps/menu-planning run dev",
    "dev:beverage": "npm --prefix apps/beverage-innovation run dev",
    "dev:events": "npm --prefix apps/events-dashboard run dev",
    "dev:delivered": "npm --prefix apps/delivered-in run dev",
    "dev:logistics": "npm --prefix apps/logistics run dev",
    "dev:launcher": "node tools/launcher/server.mjs",

    "dev:browser": "wait-on http://localhost:3100 && start chrome http://localhost:3100"
    ,"uat:seed-week": "node tools/uat/week.mjs seed"
    ,"uat:verify-week": "node tools/uat/week.mjs verify"
    ,"uat:cleanup-week": "node tools/uat/week.mjs cleanup"
    ,"golden-week:seed": "node tools/uat/week.mjs seed"
    ,"golden-week:verify": "node tools/uat/week.mjs verify"
    ,"golden-week:cleanup": "node tools/uat/week.mjs cleanup"
    ,"golden-week:e2e": "npm --prefix apps/logistics run test:e2e -- --project=golden-week"
    ,"staging:reset": "node tools/uat/reset-staging.mjs"
    ,"staging:rebuild": "npm --prefix apps/menu-planning exec -- tsx tools/uat/rebuild-staging.ts"
  },
  "dependencies": {
    "firebase-admin": "^13.4.0",
    "jszip": "^3.10.1",
    "next": "16.2.12",
    "papaparse": "^5.5.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "xlsx": "^0.18.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "wait-on": "^8.0.0"
  }
}
