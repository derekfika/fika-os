{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fika-os.local/schemas/pack-4/booking-item-quantity.schema.json",
  "title": "Booking Item Quantity and Unit",
  "description": "Draft business contract preserving what the customer ordered and what Production must prepare from BOOK-002.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "sourceDecisionIds",
    "bookingItemId",
    "ordered",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "pack-4-draft"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "sourceDecisionIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "bookingItemId": {
      "type": "string",
      "minLength": 1
    },
    "ordered": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quantity",
        "unitLabel"
      ],
      "properties": {
        "quantity": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unitLabel": {
          "type": "string",
          "minLength": 1
        },
        "unitCode": {
          "type": "string"
        },
        "catalogueReference": {
          "type": "string"
        }
      }
    },
    "productionConversion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversionType",
        "factor"
      ],
      "properties": {
        "conversionType": {
          "type": "string",
          "enum": [
            "serves_per_unit",
            "pieces_per_person",
            "other"
          ]
        },
        "factor": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "outputUnitLabel": {
          "type": "string"
        },
        "sourceReference": {
          "type": "string"
        }
      }
    },
    "productionQuantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quantity",
        "unitLabel"
      ],
      "properties": {
        "quantity": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unitLabel": {
          "type": "string",
          "minLength": 1
        },
        "unitCode": {
          "type": "string"
        },
        "catalogueReference": {
          "type": "string"
        }
      }
    }
  }
}
