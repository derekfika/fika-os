{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fika-os.local/schemas/pack-4/booking-amendment-action.schema.json",
  "title": "Booking Amendment Cancellation or Decline Action",
  "description": "Draft business contract for audited amendment, cancellation and decline actions from BOOK-006.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "sourceDecisionIds",
    "bookingId",
    "actionType",
    "reason",
    "auditHistoryPreserved",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "pack-4-draft"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "sourceDecisionIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "bookingId": {
      "type": "string",
      "minLength": 1
    },
    "actionType": {
      "type": "string",
      "enum": [
        "amend",
        "cancel",
        "decline"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "responsibleBusinessOwner": {
      "type": "string"
    },
    "approvalReference": {
      "type": "string"
    },
    "previousVersion": {
      "type": "integer",
      "minimum": 1
    },
    "newVersion": {
      "type": "integer",
      "minimum": 1
    },
    "auditHistoryPreserved": {
      "type": "boolean",
      "const": true
    },
    "effectiveAt": {
      "type": "string"
    }
  }
}
