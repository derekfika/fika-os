{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fika:schema:draft:mobilisation-phase-plan:1",
  "title": "Mobilisation Phase Plan v1 (Draft)",
  "description": "Draft ordered phase plan based on workshop references. It does not canonise the MNK-derived phase names.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mobilisationPhasePlanId", "mobilisationId", "workshopBaselineReference", "phases", "provenance", "audit"],
  "properties": {
    "schemaVersion": { "const": "1.0.0-draft.1" },
    "mobilisationPhasePlanId": { "$ref": "#/$defs/stableId" },
    "mobilisationId": { "$ref": "#/$defs/stableId" },
    "workshopBaselineReference": { "$ref": "#/$defs/stableId" },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phaseInstanceId", "phaseReference", "sequence", "optionalWork", "dependencyPhaseInstanceIds"],
        "properties": {
          "phaseInstanceId": { "$ref": "#/$defs/stableId" },
          "phaseReference": { "$ref": "#/$defs/stableId" },
          "sequence": { "type": "integer", "minimum": 1 },
          "optionalWork": { "type": "boolean" },
          "dependencyPhaseInstanceIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } }
        }
      }
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "audit": { "$ref": "#/$defs/audit" }
  },
  "$defs": {
    "stableId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$" },
    "isoDateTime": { "type": "string", "format": "date-time" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceBdrIds", "sourceSnapshot"],
      "properties": {
        "sourceBdrIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^MOB-\\d{3}$" } },
        "sourceSnapshot": { "type": "string", "minLength": 1 }
      }
    },
    "auditEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventType", "occurredAt", "actorAssignmentId"],
      "properties": {
        "eventType": { "type": "string", "minLength": 1 },
        "occurredAt": { "$ref": "#/$defs/isoDateTime" },
        "actorAssignmentId": { "$ref": "#/$defs/stableId" },
        "reason": { "type": "string" }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "createdAt", "createdByAssignmentId", "updatedAt", "updatedByAssignmentId", "events"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "createdAt": { "$ref": "#/$defs/isoDateTime" },
        "createdByAssignmentId": { "$ref": "#/$defs/stableId" },
        "updatedAt": { "$ref": "#/$defs/isoDateTime" },
        "updatedByAssignmentId": { "$ref": "#/$defs/stableId" },
        "events": { "type": "array", "items": { "$ref": "#/$defs/auditEvent" } }
      }
    }
  },
  "x-fika-source-bdrs": ["MOB-001"],
  "x-fika-status": "Draft review candidate; workshop phase names are not canonical"
}
