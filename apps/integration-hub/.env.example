# Safe local-only project identity. Do not replace with a cloud project.
FIREBASE_PROJECT_ID=fika-os-local
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
INTEGRATION_HUB_DATA_ROOT=C:\FIKA\local-data\integration-hub

# Optional local real Google Workspace sign-in. This keeps Firestore local but
# verifies Google tokens against the configured cloud Firebase project. Remove
# FIREBASE_AUTH_EMULATOR_HOST from .env.local when enabling it and provide ADC
# (GOOGLE_APPLICATION_CREDENTIALS) for the same Firebase project.
# FIKA_LOCAL_GOOGLE_AUTH=true
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# GOOGLE_APPLICATION_CREDENTIALS=C:\FIKA\secrets\firebase-admin.json

# Optional deterministic development fixtures. Leave unset for a clean workspace.
# FIKA_ENABLE_LOCAL_BOOKING_FIXTURES=true
# FIKA_ENABLE_LOCAL_PRODUCTION_FIXTURES=true

# Connector mode defaults to fixture. Live mode must be explicitly enabled locally.
BRIGHTHR_MODE=fixture
BRIGHTHR_CLIENT_ID=
BRIGHTHR_CLIENT_SECRET=
BRIGHTHR_TOKEN_URL=
BRIGHTHR_API_BASE_URL=
BRIGHTHR_ABSENCE_LOOKBACK_DAYS=30
BRIGHTHR_ABSENCE_LOOKAHEAD_DAYS=90
SQUARE_MODE=fixture
SQUARE_ACCESS_TOKEN=
SQUARE_API_BASE_URL=https://connect.squareup.com
SQUARE_API_VERSION=

# Booking email notifications. Notifications are queued and audited locally;
# set the webhook to an approved email delivery adapter to send them. The
# payload is fika.booking-email.v1 and includes siteId/siteLabel/templateKey,
# allowing each hospitality dashboard/site adapter to apply its own branding.
# CPU acceptance uses the same contract for the confirmation trigger.
FIKA_EMAIL_WEBHOOK_URL=
FIKA_EMAIL_FROM=FIKA Hospitality
FIKA_MNK_NOTIFICATION_RECIPIENTS=mnk@fikacatering.com

# CPUX Calendar source (read-only). Leave snapshot settings empty for the live
# adapter; use CPU_CALENDAR_SNAPSHOT_FILE for deterministic offline testing.
CPU_CALENDAR_OAUTH_CLIENT_FILE=C:\\FIKA\\secrets\\calendar-oauth-client.json
CPU_CALENDAR_OAUTH_TOKEN_FILE=C:\\FIKA\\secrets\\cpu-calendar-token.json
CPU_CALENDAR_LOOKBACK_DAYS=7
CPU_CALENDAR_LOOKAHEAD_DAYS=60
# CPU_CALENDAR_SNAPSHOT_FILE=C:\\FIKA\\fixtures\\cpu-calendar.json
